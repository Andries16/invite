    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.6.15",
    "@storybook/test": "^8.6.15",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitest/browser": "^2.0.0",
