{
  "name": "invite",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,html,css}\"",
    "spellcheck": "cspell \"**/*.{ts,tsx,md,mdx,json,html,css}\"",
    "storybook": "turbo run dev --filter=@invite/storybook",
    "storybook:build": "turbo run build --filter=@invite/storybook"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.4",
    "cspell": "^10.3.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "ts-morph": "^28.0.0",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "vite": "^6.4.3",
      "@vitest/browser": "^4.1.11",
      "vitest": "^4.1.11",
      "@vitest/mocker": "^4.1.11"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  }
}
